local function Trim(Value: string): string
	return Value:match("^%s*(.-)%s*$") or ""
end

local function DisconnectAll(Connections: { RBXScriptConnection }): ()
	for Index = #Connections, 1, -1 do
		local Connection = Connections[Index]
		Connections[Index] = nil :: any
		Connection:Disconnect()
	end
end

local function Track(Connections: { RBXScriptConnection }, Connection: RBXScriptConnection): RBXScriptConnection
	table.insert(Connections, Connection)
	return Connection
end

local function ExternalFunction(Name: string): ((...any) -> ...any)?
	local Value = (getfenv() :: { [string]: any })[Name]
	if type(Value) == "function" then
		return Value
	end
	return nil
end

local function Tween(Instance: Instance, Info: TweenInfo, Properties: PropertyMap): Tween
	local Previous = ActiveTweens[Instance]
	if Previous then
		Previous:Cancel()
	end

	local NextTween = TweenService:Create(Instance, Info, Properties)
	ActiveTweens[Instance] = NextTween
	NextTween.Completed:Once(function()
		if ActiveTweens[Instance] == NextTween then
			ActiveTweens[Instance] = nil
		end
	end)
	NextTween:Play()
	return NextTween
end

local function Create(ClassName: string, Properties: PropertyMap?): any
	local Instance = Instance.new(ClassName)
	if Properties then
		for Property, Value in pairs(Properties) do
			(Instance :: any)[Property] = Value
		end
	end
	return Instance
end

local function CreateCorner(Parent: Instance, Radius: number): ()
	Create("UICorner", {
		CornerRadius = UDim.new(0, Radius),
		Parent = Parent,
	})
end

local function IsScriptObject(Instance: Instance): boolean
	return Instance:IsA("LocalScript") or Instance:IsA("ModuleScript")
end

local function IsCoreInstance(Instance: Instance): boolean
	local Current: Instance? = Instance
	while Current and Current ~= game do
		local Parent = Current.Parent
		if not Parent then
			break
		end
		if Parent.ClassName == "CoreGui" or Parent.ClassName == "CorePackages" or Parent.ClassName == "LocalSaves" then
			return true
		end
		Current = Parent
	end
	return false
end

local function GetInstancePath(Instance: Instance): string
	local Parts: { string } = {}
	local Current: Instance? = Instance
	while Current and Current ~= game do
		local Name = Current.Name
		if Name:match("^[%a_][%w_]*$") then
			table.insert(Parts, 1, "." .. Name)
		else
			table.insert(Parts, 1, string.format("[%q]", Name))
		end
		Current = Current.Parent
	end
	return "game" .. table.concat(Parts)
end

local function ReadSource(ScriptObject: LocalScript | ModuleScript): string
	if RunService:IsStudio() then
		local Success, Source = pcall(function(): string
			return ScriptObject.Source
		end)
		if Success and type(Source) == "string" and Source ~= "" then
			return Source
		end
	end

	local Decompile = ExternalFunction("decompile")
	if Decompile then
		local Success, Source = pcall(Decompile, ScriptObject)
		if Success and type(Source) == "string" then
			return Source
		end
	end
	return ""
end

local function StripComments(Source: string): string
	local Output: { string } = {}
	local Length = #Source
	local Index = 1
	local Quote: string? = nil

	while Index <= Length do
		local Character = Source:sub(Index, Index)
		if Quote then
			table.insert(Output, Character)
			if Character == Quote and Source:sub(Index - 1, Index - 1) ~= "\\" then
				Quote = nil
			end
			Index += 1
		elseif Character == "\"" or Character == "'" then
			Quote = Character
			table.insert(Output, Character)
			Index += 1
		elseif Source:sub(Index, Index + 1) == "--" then
			local LongComment = Source:sub(Index, Index + 3) == "--[["
			local Closing = LongComment and Source:find("]]", Index + 4, true) or Source:find("\n", Index + 2, true)
			local Stop = Closing and (LongComment and Closing + 1 or Closing - 1) or Length
			local Removed = Source:sub(Index, Stop)
			table.insert(Output, (Removed:gsub("[^\r\n]", " ")))
			Index = Stop + 1
		else
			table.insert(Output, Character)
			Index += 1
		end
	end

	return table.concat(Output)
end

local function IsEscaped(Value: string, Position: number): boolean
	local SlashCount = 0
	for Index = Position - 1, 1, -1 do
		if Value:sub(Index, Index) ~= "\\" then
			break
		end
		SlashCount += 1
	end
	return SlashCount % 2 == 1
end

local function FindClosingParenthesis(Source: string, OpenIndex: number): number?
	local Depth = 0
	local Quote: string? = nil
	for Index = OpenIndex, #Source do
		local Character = Source:sub(Index, Index)
		if Quote then
			if Character == Quote and not IsEscaped(Source, Index) then
				Quote = nil
			end
		elseif Character == "\"" or Character == "'" then
			Quote = Character
		elseif Character == "(" then
			Depth += 1
		elseif Character == ")" then
			Depth -= 1
			if Depth == 0 then
				return Index
			end
		end
	end
	return nil
end

local function SplitArguments(Value: string): { string }
	local Arguments: { string } = {}
	local Start = 1
	local Parentheses = 0
	local Braces = 0
	local Brackets = 0
	local Quote: string? = nil

	for Index = 1, #Value do
		local Character = Value:sub(Index, Index)
		if Quote then
			if Character == Quote and not IsEscaped(Value, Index) then
				Quote = nil
			end
		elseif Character == "\"" or Character == "'" then
			Quote = Character
		elseif Character == "(" then
			Parentheses += 1
		elseif Character == ")" then
			Parentheses -= 1
		elseif Character == "{" then
			Braces += 1
		elseif Character == "}" then
			Braces -= 1
		elseif Character == "[" then
			Brackets += 1
		elseif Character == "]" then
			Brackets -= 1
		elseif Character == "," and Parentheses == 0 and Braces == 0 and Brackets == 0 then
			local Argument = Trim(Value:sub(Start, Index - 1))
			if Argument ~= "" then
				table.insert(Arguments, Argument)
			end
			Start = Index + 1
		end
	end

	local LastArgument = Trim(Value:sub(Start))
	if LastArgument ~= "" then
		table.insert(Arguments, LastArgument)
	end
	return Arguments
end

local function CollectAliases(Source: string, ScriptObject: LocalScript | ModuleScript): StringMap
	local Aliases: StringMap = { script = GetInstancePath(ScriptObject) }
	for Line in Source:gmatch("[^\r\n]+") do
		local Name, Value = Line:match("^%s*local%s+([%a_][%w_]*)%s*=%s*(.-)%s*$")
		if not Name then
			Name, Value = Line:match("^%s*([%a_][%w_]*)%s*=%s*(.-)%s*$")
		end
		if Name and Value then
			Value = Trim(Value)
			if #Value <= 1024 and not Value:find("function", 1, true) and not Value:find(";", 1, true) then
				Aliases[Name] = Value
			end
		end
	end
	return Aliases
end

local function ResolveAlias(Expression: string, Aliases: StringMap): string
	local Resolved = Trim(Expression)
	for _ = 1, 5 do
		local Name = Resolved:match("^([%a_][%w_]*)")
		local Replacement = Name and Aliases[Name]
		if not Replacement or Replacement == Name then
			break
		end
		Resolved = Replacement .. Resolved:sub(#Name + 1)
	end
	return Resolved
end

local function FindReceiverStart(Source: string, ColonIndex: number): number
	local Index = ColonIndex - 1
	while Index > 0 do
		local Character = Source:sub(Index, Index)
		if Character == "\n" or Character == "\r" or Character == ";" or Character == "=" or Character == "," then
			break
		end
		Index -= 1
	end
	return Index + 1
end

local function NormalizeEventPart(Value: string): string
	Value = Trim(Value)
	Value = Value:gsub("%s+", " ")
	Value = Value:gsub("%s*([%,%(%)%{%}%[%]])%s*", "%1")
	return Value
end

local function GetEventSignature(Receiver: string, Method: RemoteMethod, Arguments: { string }): string
	local NormalizedReceiver = NormalizeEventPart(Receiver)
	local NormalizedArguments = table.create(#Arguments)

	for Index, Argument in Arguments do
		NormalizedArguments[Index] = NormalizeEventPart(Argument)
	end

	return NormalizedReceiver .. "|" .. Method .. "|" .. table.concat(NormalizedArguments, ",")
end

local function ExtractCalls(Source: string, ScriptObject: LocalScript | ModuleScript): { RemoteCall }
	local Stripped = StripComments(Source)
	local Aliases = CollectAliases(Stripped, ScriptObject)
	local Calls: { RemoteCall } = {}
	local Seen: { [string]: boolean } = {}
	local Quote: string? = nil
	local Index = 1

	while Index <= #Stripped do
		local Character = Stripped:sub(Index, Index)

		if Quote then
			if Character == Quote and not IsEscaped(Stripped, Index) then
				Quote = nil
			end
			Index += 1

		elseif Character == "\"" or Character == "'" then
			Quote = Character
			Index += 1

		elseif Character == ":" then
			local MatchedMethod: RemoteMethod? = nil
			local OpenIndex = 0

			for _, Method in RemoteMethods do
				local MethodStart = Index + 1

				if Stripped:sub(MethodStart, MethodStart + #Method - 1) == Method then
					local Cursor = MethodStart + #Method

					while Stripped:sub(Cursor, Cursor):match("%s") do
						Cursor += 1
					end

					if Stripped:sub(Cursor, Cursor) == "(" then
						MatchedMethod = Method
						OpenIndex = Cursor
						break
					end
				end
			end

			if MatchedMethod then
				local CloseIndex = FindClosingParenthesis(Stripped, OpenIndex)

				if CloseIndex then
					local Receiver = Trim(
						Stripped:sub(
							FindReceiverStart(Stripped, Index),
							Index - 1
						)
					)

					Receiver = Receiver:gsub("^return%s+", "")

					local Arguments = SplitArguments(
						Stripped:sub(OpenIndex + 1, CloseIndex - 1)
					)

					for ArgumentIndex, Argument in Arguments do
						Arguments[ArgumentIndex] = ResolveAlias(Argument, Aliases)
					end

					local ResolvedReceiver = ResolveAlias(Receiver, Aliases)

					local Expression = string.format(
						"%s:%s(%s)",
						ResolvedReceiver,
						MatchedMethod,
						table.concat(Arguments, ", ")
					)

					local Signature = GetEventSignature(
						ResolvedReceiver,
						MatchedMethod,
						Arguments
					)

					if Receiver ~= "" and not Seen[Signature] then
						Seen[Signature] = true

						table.insert(Calls, {
							expression = Expression,
							method = MatchedMethod,
						})
					end

					Index = CloseIndex + 1
				else
					Index += 1
				end
			else
				Index += 1
			end
		else
			Index += 1
		end
	end

	return Calls
end

local function Analyze(ScriptObject: LocalScript | ModuleScript): CacheEntry
	local Cached = ScriptCache[ScriptObject]
	if Cached then
		return Cached
	end
	local Source = ReadSource(ScriptObject)
	local Cache: CacheEntry = {
		source = Source,
		calls = Source ~= "" and ExtractCalls(Source, ScriptObject) or {},
	}
	ScriptCache[ScriptObject] = Cache
	return Cache
end

local function FormatCalls(Calls: { RemoteCall }): string
	if #Calls == 0 then
		return EmptyOutput
	end
	local Sections = table.create(#Calls)
	for Index, Call in Calls do
		Sections[Index] = string.format("pcall(function()\n\t%s\nend)", Call.expression)
	end
	return table.concat(Sections, "\n\n")
end

local function GetDisplayName(Item: ScriptItem, DuplicateIndex: number): string
	local Suffix = Item.object:IsA("ModuleScript") and " [Module]" or ""
	if DuplicateIndex > 0 then
		Suffix ..= string.format(" (%d)", DuplicateIndex + 1)
	end
	return Item.object.Name .. Suffix
end

local function UpdateCanvas(ScrollingFrame: ScrollingFrame, Layout: UIListLayout): ()
	ScrollingFrame.CanvasSize = UDim2.fromOffset(0, Layout.AbsoluteContentSize.Y + 6)
end

local function UpdateTextCanvas(ScrollingFrame: ScrollingFrame, TextBox: TextBox): ()
	local Width = math.max(ScrollingFrame.AbsoluteSize.X - 12, 1)
	local Size = TextService:GetTextSize(TextBox.Text, TextBox.TextSize, TextBox.Font, Vector2.new(Width, math.huge))
	TextBox.Size = UDim2.new(TextBox.Size.X.Scale, TextBox.Size.X.Offset, 0, math.max(Size.Y + 12, ScrollingFrame.AbsoluteSize.Y - 6))
	ScrollingFrame.CanvasSize = UDim2.fromOffset(0, TextBox.Position.Y.Offset + TextBox.Size.Y.Offset + 6)
end

local function AddLog(Message: string): ()
	local CurrentUi = Ui
	if not CurrentUi or Destroyed then
		return
	end
	local Timestamp = os.date("%H:%M:%S")
	local Existing = CurrentUi.logOutput.Text
	CurrentUi.logOutput.Text = Existing == "" and string.format("[%s] %s", Timestamp, Message)
		or string.format("%s\n[%s] %s", Existing, Timestamp, Message)
	UpdateTextCanvas(CurrentUi.logPanel, CurrentUi.logOutput)
	CurrentUi.logPanel.CanvasPosition = Vector2.new(0, math.max(CurrentUi.logPanel.CanvasSize.Y.Offset, 0))
end

local function UpdateIndicators(Item: ScriptItem): ()
	for _, Child in Item.indicators:GetChildren() do
		if Child:IsA("Frame") then
			Child:Destroy()
		end
	end
	local Shown: { [RemoteMethod]: boolean } = {}
	local IndicatorCount = 0
	for _, Call in Item.cache.calls do
		if not Shown[Call.method] then
			Shown[Call.method] = true
			IndicatorCount += 1
			local Indicator = Create("Frame", {
				BackgroundColor3 = MethodColors[Call.method],
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(5, 5),
			})
			CreateCorner(Indicator, 3)
			Indicator.Parent = Item.indicators
		end
	end
	
	local LabelPosition = 2 + (IndicatorCount * 8) - 3 + 5
	Item.label.Position = UDim2.fromOffset(LabelPosition, 2)
	Item.label.Size = UDim2.new(1, -(LabelPosition + 6), 0, 16)
end

local function UpdateItemVisual(Item: ScriptItem): ()
	Item.button.BackgroundColor3 = Item.selected and CONFIG.selected or CONFIG.surfaceElevated
	Item.label.TextColor3 = Item.selected and Color3.new(1, 1, 1) or CONFIG.text
end

local function ShowSelectedItem(Item: ScriptItem?): ()
	local CurrentUi = Ui
	if not CurrentUi then
		return
	end
	SelectedItem = Item
	for _, Entry in ScriptItems do
		Entry.selected = Entry == Item
		UpdateItemVisual(Entry)
	end
	CurrentUi.eventOutput.Text = Item and FormatCalls(Item.cache.calls) or NoSelectionOutput
	UpdateTextCanvas(CurrentUi.eventList, CurrentUi.eventOutput)
	if Item then
		UpdateIndicators(Item)
	end
end

local function FuzzyScore(Query: string, Target: string): number
	local QueryIndex = 1
	local Score = 0
	local PreviousMatch = 0
	for Index = 1, #Target do
		if Target:sub(Index, Index) == Query:sub(QueryIndex, QueryIndex) then
			Score += Index == PreviousMatch + 1 and 12 or 3
			PreviousMatch = Index
			QueryIndex += 1
			if QueryIndex > #Query then
				return Score
			end
		end
	end
	return 0
end

local function ScoreItem(Item: ScriptItem, Query: string): number
	if Item.nameLower == Query then
		return 10_000
	end
	if Item.nameLower:sub(1, #Query) == Query then
		return 8_000
	end
	local PlainIndex = Item.nameLower:find(Query, 1, true) or Item.pathLower:find(Query, 1, true)
	if PlainIndex then
		return 4_000 - PlainIndex
	end
	return FuzzyScore(Query, Item.nameLower)
end

local function UpdateSearch(): ()
	local CurrentUi = Ui
	if not CurrentUi then
		return
	end
	local Query = Trim(CurrentUi.searchBox.Text:lower())
	for _, Item in ScriptItems do
		local Score = Query == "" and 1 or ScoreItem(Item, Query)
		Item.frame.Visible = Score > 0
		Item.frame.LayoutOrder = Query == "" and Item.order or -Score
	end
end

local function UpdateItemOrder(): ()
	table.sort(ScriptItems, function(Left, Right)
		if Left.nameLower == Right.nameLower then
			return Left.discoveryOrder < Right.discoveryOrder
		end

		return Left.nameLower < Right.nameLower
	end)

	local DuplicateCounts: { [string]: number } = {}

	for Index, Item in ScriptItems do
		local NameKey = Item.nameLower
		local Count = (DuplicateCounts[NameKey] or 0) + 1
		DuplicateCounts[NameKey] = Count

		Item.order = Index
		Item.frame.LayoutOrder = Index

		Item.label.Text = GetDisplayName(Item, Count - 1)
	end

	UpdateSearch()
end

local function RemoveItem(ScriptObject: LocalScript | ModuleScript): ()
	local Item = ItemsByObject[ScriptObject]
	if not Item then
		return
	end
	if SelectedItem == Item then
		ShowSelectedItem(nil)
	end
	DisconnectAll(Item.connections)
	Item.frame:Destroy()
	ItemsByObject[ScriptObject] = nil
	ScriptCache[ScriptObject] = nil
	for Index, Existing in ScriptItems do
		if Existing == Item then
			table.remove(ScriptItems, Index)
			break
		end
	end
	UpdateItemOrder()
end

local function GetDuplicateSignature(Cache: CacheEntry): string
	local Parts = table.create(#Cache.calls)

	for Index, Call in Cache.calls do
		Parts[Index] = Call.method .. "|" .. Call.expression
	end

	return table.concat(Parts, "\n")
end

local function AddItem(ScriptObject: LocalScript | ModuleScript): ()
	local CurrentUi = Ui
	if not CurrentUi or IsCoreInstance(ScriptObject) or ItemsByObject[ScriptObject] then
		return
	end

	local Cache = Analyze(ScriptObject)
	if #Cache.calls == 0 then
		return
	end

	local Signature = GetDuplicateSignature(Cache)
	if DuplicateSignatures[Signature] then
		return
	end

	DuplicateSignatures[Signature] = true

	OrderCounter += 1
	local Frame = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -6, 0, 22),
		Parent = CurrentUi.scriptList,
	})
	local Button = Create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = CONFIG.surfaceElevated,
		BorderColor3 = CONFIG.border,
		BorderSizePixel = 1,
		Position = UDim2.fromOffset(0, 2),
		Size = UDim2.new(1, 0, 0, 18),
		Text = "",
		Parent = Frame,
	})
	CreateCorner(Button, 3)
	local Indicators = Create("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(2, 8),
		Size = UDim2.fromOffset(35, 6),
		Parent = Frame,
	})
	Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 3),
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = Indicators,
	})
	local Label = Create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Position = UDim2.fromOffset(42, 2),
		Size = UDim2.new(1, -48, 0, 16),
		TextColor3 = CONFIG.text,
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = ScriptObject.Name,
		Parent = Frame,
	})
	local Item: ScriptItem = {
		object = ScriptObject,
		cache = Cache,
		frame = Frame,
		button = Button,
		label = Label,
		indicators = Indicators,
		connections = {},
		nameLower = ScriptObject.Name:lower(),
		pathLower = GetInstancePath(ScriptObject):lower(),
		order = OrderCounter,
		discoveryOrder = OrderCounter,
		selected = false,
	}
	ItemsByObject[ScriptObject] = Item
	table.insert(ScriptItems, Item)
	UpdateIndicators(Item)
	Track(Item.connections, Button.MouseButton1Click:Connect(function()
		if SelectedItem == Item then
			ShowSelectedItem(nil)
		else
			ShowSelectedItem(Item)
		end
	end))
	Track(Item.connections, Button.MouseEnter:Connect(function()
		Tween(Button, FastTween, { BackgroundColor3 = Item.selected and CONFIG.selectedHover or CONFIG.surfaceHover })
	end))
	Track(Item.connections, Button.MouseLeave:Connect(function()
