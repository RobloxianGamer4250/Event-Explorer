local function ScanScripts(): { LocalScript | ModuleScript }
	local Found: { LocalScript | ModuleScript } = {}
	for _, Instance in game:GetDescendants() do
		if IsScriptObject(Instance) and not IsCoreInstance(Instance) then
			table.insert(Found, Instance :: LocalScript | ModuleScript)
		end
	end
	return Found
end

local function ClearScripts(): ()
	for _, Item in ScriptItems do
		DisconnectAll(Item.connections)
		Item.frame:Destroy()
	end

	table.clear(ScriptItems)
	table.clear(ItemsByObject)
	table.clear(ScriptCache)
	table.clear(DuplicateSignatures)

	OrderCounter = 0
	ShowSelectedItem(nil)
end

local function RefreshScripts(): ()
	ClearScripts()
	local Found = ScanScripts()
	
	task.spawn(function()
		for _, ScriptObject in Found do
			AddItem(ScriptObject)
		end
		UpdateItemOrder()
		AddLog(#ScriptItems > 0 and string.format("Found %d scripts.", #ScriptItems) or "No scripts found.")
	end)
end

local function CopyToClipboard(Value: string): boolean
	local Clipboard = ExternalFunction("setclipboard") or ExternalFunction("toclipboard")
	if not Clipboard then
		return false
	end
	return pcall(Clipboard, Value)
end

local function ExecuteOutput(): ()
	local CurrentUi = Ui
	if not CurrentUi or not SelectedItem or CurrentUi.eventOutput.Text == EmptyOutput or CurrentUi.eventOutput.Text == NoSelectionOutput then
		AddLog("Nothing to execute.")
		return
	end
	local Loadstring = ExternalFunction("loadstring")
	if not Loadstring then
		AddLog("Loadstring not available.")
		return
	end
	local CompiledOk, CompiledOrError = pcall(Loadstring, CurrentUi.eventOutput.Text)
	if not CompiledOk or type(CompiledOrError) ~= "function" then
		AddLog("Compile failed.")
		return
	end
	task.spawn(function()
		local Success, Message = pcall(CompiledOrError)
		AddLog(Success and "Executed." or string.format("Failed: %s", tostring(Message)))
	end)
end

