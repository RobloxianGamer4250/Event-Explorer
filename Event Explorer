	Minimized = not Minimized
	if Minimized then
		WindowSize = Vector2.new(CurrentUi.window.Size.X.Offset, CurrentUi.window.Size.Y.Offset)
		CurrentUi.scriptPanel.Visible = false
		CurrentUi.eventPanel.Visible = false
