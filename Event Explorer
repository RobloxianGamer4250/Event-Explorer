		CurrentUi.resizeHandle.Visible = false
		Tween(CurrentUi.window, MediumTween, { Size = UDim2.new(0, WindowSize.X, 0, CONFIG.headerHeight) })
	else
		Tween(CurrentUi.window, MediumTween, { Size = UDim2.new(0, WindowSize.X, 0, WindowSize.Y) })
		CurrentUi.scriptPanel.Visible = true
		CurrentUi.eventPanel.Visible = true
