		CurrentUi.resizeHandle.Visible = true
	end
end

local function SetupInputHandling(): ()
	local CurrentUi = Ui
	if not CurrentUi then
		return
	end
	Track(UiConnections, CurrentUi.header.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			DragState = {
				start = Input.Position,
				position = CurrentUi.window.Position,
			}
		end
	end))
	Track(UiConnections, CurrentUi.resizeHandle.InputBegan:Connect(function(Input)
		if not Minimized and (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) then
			ResizeState = {
				start = Input.Position,
				size = CurrentUi.window.Size,
			}
		end
	end))
	Track(UiConnections, UserInputService.InputChanged:Connect(function(Input)
		if Input.UserInputType ~= Enum.UserInputType.MouseMovement and Input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if DragState then
			local Delta = Input.Position - DragState.start
			CurrentUi.window.Position = UDim2.new(
				DragState.position.X.Scale,
				DragState.position.X.Offset + Delta.X,
				DragState.position.Y.Scale,
				DragState.position.Y.Offset + Delta.Y
			)
		elseif ResizeState then
			local Delta = Input.Position - ResizeState.start
			local Width = math.max(CONFIG.minimumWidth, ResizeState.size.X.Offset + Delta.X)
			local Height = math.max(CONFIG.minimumHeight, ResizeState.size.Y.Offset + Delta.Y)
			CurrentUi.window.Size = UDim2.fromOffset(Width, Height)
			WindowSize = Vector2.new(Width, Height)
		end
	end))
	Track(UiConnections, UserInputService.InputEnded:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			DragState = nil
			ResizeState = nil
		end
	end))
end

